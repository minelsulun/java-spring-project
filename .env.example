# QuestApp backend ortam değişkenleri (örnek)
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerleri girin. `.env` commit'lenmez.

# --- Veritabanı ---
# DB_URL=jdbc:mysql://localhost:3306/quest-app   # opsiyonel, default var
# DB_USERNAME=root                                # opsiyonel, default var
DB_PASSWORD=degistir-beni

# --- JWT ---
# Base64 kodlu, en az 256-bit (32 byte) bir secret üretin:
#   openssl rand -base64 32
JWT_SECRET=base64-secret-buraya
# JWT_EXPIRES_IN=604800                           # opsiyonel (saniye), default 7 gün
